#!/usr/bin/with-contenv bash
# Wrapper that lets this image run with `docker --init` (tini as PID 1).
#
# The baseimage is designed around s6-overlay v3, which reads container
# env vars from /run/s6/container_environment (an envdir). Stock Docker
# populates that dir for you; some hosts (notably RunPod under --init)
# don't, which is why you see:
#
#   s6-envdir: fatal: unable to envdir /run/s6/container_environment:
#              No such file or directory
#
# Two changes make this resilient on any host, regardless of how /run is
# pre-populated:
#
#   1. unshare -fpm gives /init its own PID + mount namespaces.
#        -p  s6-overlay-suexec insists on PID 1 in its PID NS.
#        -m  s6-overlay then mounts its own tmpfs at /run and creates
#            /run/s6/container_environment itself, no race with the host.
#
#   2. S6_KEEP_ENV=1 instructs s6-overlay to inherit the existing env
#      directly instead of routing through with-contenv and s6-envdir.
#      Even if /run/s6/container_environment never gets populated for
#      any reason, every service still sees the original Docker env.

set -eu

# S6_KEEP_ENV=1 makes with-contenv a no-op so services don't need the
# /run/s6/container_environment envdir to be present. Export it before
# unshare so the env value propagates into the new namespace via the
# inherited environment.
export S6_KEEP_ENV="${S6_KEEP_ENV:-1}"

exec /usr/bin/unshare -fpm -- /init "$@"
