#!/usr/bin/with-contenv bash
# Wrapper that lets this image run with `docker --init` (tini as PID 1).
#
# Two problems to solve simultaneously:
#   1. s6-overlay-suexec refuses to run unless it sees PID 1 in its PID
#      namespace.
#   2. s6-envdir reports "unable to envdir /run/s6/container_environment"
#      when the envdir doesn't exist yet (some hosts, e.g. RunPod under
#      --init, don't pre-populate /run/s6 the way stock Docker does).
#
# Both are addressed by doing `unshare -pm` with a fresh mount namespace:
#   -p  s6-suexec sees its own namespace's PID 1 (unshare makes getpid()==1)
#   -m  gives /run a brand-new tmpfs (s6-overlay then creates /run/s6 +
#      /run/s6/container_environment itself, no race with whatever the host
#      had pre-mounted under /run)
#
# We mount the tmpfs over /run *before* execing /init. s6-overlay already
# has logic to mount /run itself ("/run exists and is writable. If it is
# not, it will attempt to mount a tmpfs there.") so the manual mount just
# guarantees the directory layout s6-overlay expects, eliminating the
# envdir error on hosts where the parent mount NS has nothing useful under
# /run.
#
# Outside the new namespaces, tini is still PID 1, so --init keeps its
# signal/zombie-reaping semantics.

set -eu

# Build a small mount+pid pair, then exec /init.
#
# We can't mount the tmpfs directly inside `unshare -m` shell because some
# runtimes disallow unprivileged mounts in user namespaces. So we use a
# separate unshare just for mounting the tmpfs, then re-enter /init with
# both -p and -m. The child tmpfs lives only in /run, so /etc and the rest
# of the filesystem remain read-only-root-safe if the caller sets
# S6_READ_ONLY_ROOT=1.

if ! mountpoint -q /run 2>/dev/null; then
  # /run is not a mount in the inherited mount table (typical on RunPod).
  # Bind-mount /run onto itself so the new mount namespace gets a stable
  # mount point to overlay.
  mount --bind /run /run 2>/dev/null || true
fi

exec /usr/bin/unshare -fpm -- /init "$@"
