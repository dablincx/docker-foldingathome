#!/usr/bin/env bash
# Entrypoint for foldingathome. Replaces the previous s6-overlay tree with a
# straightforward shell script that does what s6 used to:
#
#   1. Fix /config ownership (was: init-foldingathome-config)
#   2. Grant /dev/dri access to the abc user (was: init-foldingathome-video)
#   3. Run fah-client in the foreground as user abc
#      (was: svc-foldingathome)
#
# No s6, no unshare, no pid-1 gymnastics needed.

set -eu

# 1. Permissions on config root and folders.
if [ -d /config ]; then
    chown -R abc:abc /config || true
fi

# 2. /dev/dri (hardware video encode) permissions. Mirrors the previous
# init-foldingathome-video logic exactly.
FILES=$(find /dev/dri /dev/dvb -type c -print 2>/dev/null || true)
for dev in $FILES; do
    VIDEO_GID=$(stat -c '%g' "${dev}")
    VIDEO_UID=$(stat -c '%u' "${dev}")
    if id -u abc | grep -qw "${VIDEO_UID}"; then
        :
    elif id -G abc | grep -qw "${VIDEO_GID}" \
         && [ "$(stat -c '%A' "${dev}" | cut -b 5,6)" = "rw" ]; then
        :
    else
        VIDEO_NAME=$(getent group "${VIDEO_GID}" | awk -F: '{print $1}')
        if [ -z "${VIDEO_NAME}" ]; then
            VIDEO_NAME="video$(head /dev/urandom | tr -dc 'a-z0-9' | head -c4)"
            groupadd "${VIDEO_NAME}"
            groupmod -g "${VIDEO_GID}" "${VIDEO_NAME}"
            echo "creating video group ${VIDEO_NAME} with id ${VIDEO_GID}"
        fi
        usermod -a -G "${VIDEO_NAME}" abc
        if [ "$(stat -c '%A' "${dev}" | cut -b 5,6)" != "rw" ]; then
            chmod g+rw "${dev}" || true
        fi
    fi
done

# 3. Final env-var nudging; warn if ACCOUNT_TOKEN / MACHINE_NAME missing.
if [[ -n "${ACCOUNT_TOKEN}" ]] && [[ -n "${MACHINE_NAME}" ]]; then
    TOKEN_AND_NAME="--account-token ${ACCOUNT_TOKEN} --machine-name ${MACHINE_NAME}"
else
    cat <<'EOF' >&2

***************************************************************************
****                                                                   ****
****  On first run, both ACCOUNT_TOKEN and MACHINE_NAME env vars are   ****
****  required unless the instance was previously added to online      ****
****  account.                                                         ****
****                                                                   ****
***************************************************************************

EOF
    TOKEN_AND_NAME=""
fi

# 4. Exec fah-client as user abc. cd to /config so any relative paths the
#    user passes in CLI_ARGS resolve correctly.
cd /config
exec setpriv --reuid=abc --regid=abc --clear-groups \
    /app/fah-client \
        --http-addresses 0.0.0.0:7396 \
        --allow 0/0 \
        ${TOKEN_AND_NAME} \
        ${CLI_ARGS:-}
