#!/usr/bin/with-contenv bash
# Wrapper that lets this image run with `docker --init` (tini as PID 1).
#
# s6-overlay-suexec refuses to start unless it is PID 1 in its PID namespace,
# so we re-exec /init inside fresh PID + mount namespaces via `unshare -fpm`:
#   -p  s6-suexec needs to be PID 1
#   -m  isolate /run/s6 from the host namespace (otherwise s6-envdir reads
#       a stale or missing /run/s6/container_environment and aborts before
#       the baseimage's own init scripts get a chance to populate it)
#
# Inside the new namespace s6 sees itself as PID 1; outside, tini stays
# PID 1 so `docker --init` still reaps zombies and forwards signals.

set -eu

# Belt-and-braces: ensure the envdir exists before s6-overlay's init opens
# it. With `unshare -m`, the parent mount NS may carry an empty (or
# nonexistent) /run/s6; creating the directory here lets s6-envdir open
# it successfully even on hosts that don't pre-mount anything under /run.
mkdir -p /run/s6/container_environment

# Seed the envdir from /proc/1/environ (NUL-separated, the original Docker
# env), not from `env` -- `with-contenv` already strips Docker vars from
# the shell's view on hosts like RunPod, so `env` here would yield nothing.
# Each file's content is the bare value (no trailing newline), matching
# s6-envdir's expected layout.
if [ -r /proc/1/environ ]; then
    while IFS= read -r -d '' entry; do
        key="${entry%%=*}"
        val="${entry#*=}"
        case "$key" in
            HOSTNAME|HOME|PATH|TERM|SHLVL|PWD|_|LSIO_FIRST_PART1)
                continue
                ;;
        esac
        printf '%s' "$val" > "/run/s6/container_environment/$key"
    done < /proc/1/environ
fi

exec /usr/bin/unshare -fpm -- /init "$@"
